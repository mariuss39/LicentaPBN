<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.ItemsActivity">
<Button
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Available"
    android:padding="12dp"
    android:textStyle="bold"
    android:id="@+id/button_filter_availabe_items"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toStartOf="@id/button_reset_filter_items"></Button>
    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="All"
        android:textStyle="bold"
        android:padding="12dp"
        android:id="@+id/button_reset_filter_items"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/button_filter_availabe_items"
        app:layout_constraintEnd_toStartOf="@id/button_filter_unavailable_items"
        ></Button>
    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unavailable"
        android:textStyle="bold"
        android:padding="12dp"
        android:id="@+id/button_filter_unavailable_items"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/button_reset_filter_items"></Button>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Available"
        android:padding="12dp"
        android:textStyle="bold"
        android:visibility="gone"
        android:id="@+id/future_button_filter_availabe_items"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/future_button_reset_filter_items"></Button>
    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="All"
        android:visibility="gone"
        android:textStyle="bold"
        android:padding="12dp"
        android:id="@+id/future_button_reset_filter_items"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/future_button_filter_availabe_items"
        app:layout_constraintEnd_toStartOf="@id/future_button_filter_unavailable_items"
        ></Button>
    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reserved"
        android:visibility="gone"
        android:textStyle="bold"
        android:padding="12dp"
        android:id="@+id/future_button_filter_unavailable_items"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/future_button_reset_filter_items"></Button>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvSelectDate_itemsactivity"
        android:textColor="@color/black"
        android:text="Select date:"
        android:textStyle="bold"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/button_filter_availabe_items"
        app:layout_constraintBottom_toTopOf="@id/recyclerview_items_container"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        />
    <TextView
        android:id="@+id/tvDate_itemsactivity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pick Date \u25BC"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:textSize="16sp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toTopOf="@id/recyclerview_items_container"
        app:layout_constraintStart_toEndOf="@id/tvSelectDate_itemsactivity"
        app:layout_constraintTop_toBottomOf="@id/button_filter_availabe_items"
        android:textColor="@android:color/holo_blue_dark"/>

    <androidx.recyclerview.widget.RecyclerView
    android:layout_width="match_parent"
    android:id="@+id/recyclerview_items_container"
    android:layout_height="0dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/tvDate_itemsactivity" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

</androidx.constraintlayout.widget.ConstraintLayout>