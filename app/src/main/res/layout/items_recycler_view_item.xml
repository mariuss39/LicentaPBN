<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:id="@+id/item_cardview"
        android:layout_width="match_parent"
        app:cardCornerRadius="20dp"
        android:elevation="20dp"
        app:contentPadding="12dp"
        android:layout_margin="12dp"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/visible_item_layout_constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/recyclerImage"
                android:layout_width="80sp"
                android:layout_height="80sp"
                android:scaleType="fitCenter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <ImageView
                android:id="@+id/info_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/info_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
            </ImageView>
            <TextView
                android:id="@+id/tv_name_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Nume item"
                android:textSize="18sp"
                android:textAlignment="center"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/tv_status_item"
                app:layout_constraintStart_toEndOf="@+id/recyclerImage"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/info_icon"/>
            <TextView
                android:id="@+id/tv_status_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status item"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textColor="#757575"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toEndOf="@id/recyclerImage"
                app:layout_constraintTop_toBottomOf="@id/tv_name_item"
                app:layout_constraintEnd_toStartOf="@id/info_icon"
                app:layout_constraintBottom_toTopOf="@id/tv_reservation_status_item"/>
            <TextView
                android:id="@+id/tv_reservation_status_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reservation status item"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textColor="#757575"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toEndOf="@id/recyclerImage"
                app:layout_constraintTop_toBottomOf="@id/tv_status_item"
                app:layout_constraintEnd_toStartOf="@id/info_icon"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"
                android:id="@+id/invisible_constraint_layout"
                app:layout_constraintTop_toBottomOf="@id/recyclerImage"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"

                >
                <Button
                    android:id="@+id/tv_reserve"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reserve"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:visibility="visible"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/tv_cancel_reserve"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    />
                <Button
                    android:id="@+id/tv_cancel_reserve"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cancel Reserve"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:visibility="visible"
                    app:layout_constraintTop_toBottomOf="@id/tv_reserve"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.cardview.widget.CardView>

</RelativeLayout>