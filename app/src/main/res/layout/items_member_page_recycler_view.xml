<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:id="@+id/item_cardview_memberPage"
        android:layout_width="match_parent"
        app:cardCornerRadius="20dp"
        android:elevation="20dp"
        app:contentPadding="12dp"
        android:layout_margin="12dp"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/visible_item_layout_constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/recyclerMemberPageImage"
                android:layout_width="80sp"
                android:layout_height="60sp"
                android:scaleType="fitCenter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginRight="8dp"
                />
            <TextView
                android:textColor="@color/black"
                android:id="@+id/tv_name_item_memberPage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Nume item"
                android:textSize="14sp"
                android:textAlignment="center"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/tv_id_recycler_memberpage"
                app:layout_constraintStart_toEndOf="@id/recyclerMemberPageImage"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            <TextView
                android:textColor="@color/black"
                android:id="@+id/tv_id_recycler_memberpage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Id item"
                android:textSize="12sp"
                android:textAlignment="center"
                android:textStyle="italic"
                app:layout_constraintStart_toEndOf="@id/recyclerMemberPageImage"
                app:layout_constraintTop_toBottomOf="@id/tv_name_item_memberPage"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>